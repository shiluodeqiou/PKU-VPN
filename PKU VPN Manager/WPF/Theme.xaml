<!--
  ============================================================================
  Theme.xaml — 通用 WPF 主题（源自 ImageSearch「以图搜图」界面）
  ============================================================================

  适用场景：WPF 桌面工具的浅色主题，卡片式布局 + 蓝色强调色。

  用法（在 App.xaml 中引入一次即可全局生效）：

      <Application x:Class="YourApp.App"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Application.Resources>
          <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="pack://application:,,,/UI参考;component/WPF/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
        </Application.Resources>
      </Application>

  或按相对路径直接引入：
      <ResourceDictionary Source="WPF/Theme.xaml" />

  ===========================================================================
  设计说明
  ===========================================================================
  · 全部颜色以「语义化令牌」（第 1 节）定义，样式只引用令牌。
    要换主题色，只改第 1 节即可，无需逐个修改样式。
  · 本文件不依赖任何 code-behind 或自定义转换器，可直接复制到任意项目使用。
  · 控件高度统一为 36，圆角按层级递进（3/4/5/6/8/10），详见《设计规范.md》。
  ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ========================================================================
       第 1 节 · 设计令牌（Design Tokens）
       颜色命名规则：用途 + 深浅，例如 PrimaryHoverBrush = 主色悬停态
       ======================================================================== -->

  <!-- 1.1 主色（强调色） -->
  <Color x:Key="PrimaryColor">#FF007ACC</Color>
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF005A9E" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF004B87" />
  <SolidColorBrush x:Key="PrimaryTintBrush" Color="#FFE6F3FF" />

  <!-- 1.2 语义色（状态提示） -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF28A745" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FFD32F2F" />
  <SolidColorBrush x:Key="DangerLightBrush" Color="#FFFF6B6B" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFFFA500" />
  <SolidColorBrush x:Key="InfoBrush" Color="#FF9C27B0" />

  <!-- 1.3 文字（由深到浅） -->
  <SolidColorBrush x:Key="TextHeadingBrush" Color="#FF2C3E50" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF333333" />
  <SolidColorBrush x:Key="TextLabelBrush" Color="#FF555555" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF666666" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#FF777777" />
  <SolidColorBrush x:Key="TextSubtleBrush" Color="#FF999999" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#FFAAAAAA" />

  <!-- 1.4 边框与分隔线 -->
  <SolidColorBrush x:Key="BorderInputBrush" Color="#FFCCCCCC" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFDDDDDD" />
  <SolidColorBrush x:Key="BorderDividerBrush" Color="#FFE0E0E0" />
  <SolidColorBrush x:Key="BorderHoverBrush" Color="#FF999999" />
  <SolidColorBrush x:Key="GridLineBrush" Color="#FFF0F0F0" />
  <SolidColorBrush x:Key="TrackBrush" Color="#FFE0E0E0" />

  <!-- 1.5 表面（背景层级） -->
  <SolidColorBrush x:Key="SurfaceWindowBrush" Color="#FFF5F5F5" />
  <SolidColorBrush x:Key="SurfacePanelBrush" Color="#FFF8F9FA" />
  <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SurfaceAltRowBrush" Color="#FFFAFAFA" />
  <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="#FFF5F5F5" />

  <!-- 1.6 行状态（列表 / 表格） -->
  <SolidColorBrush x:Key="RowHoverBrush" Color="#FFE6F3FF" />
  <SolidColorBrush x:Key="RowSelectedBrush" Color="#FFCCE8FF" />

  <!-- 1.7 尺寸令牌（供 code-behind 或统一调整使用） -->
  <sys:Double x:Key="ControlHeight">36</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeSmall">12</sys:Double>
  <sys:Double x:Key="FontSizeSectionHeader">15</sys:Double>
  <!-- 圆角令牌（类型必须是 CornerRadius，不能用 Double） -->
  <CornerRadius x:Key="RadiusInput">4</CornerRadius>
  <CornerRadius x:Key="RadiusButton">5</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">6</CornerRadius>
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>

  <!-- 1.8 阴影令牌 -->
  <DropShadowEffect x:Key="CardShadowEffect"
                    Color="#FF000000"
                    Opacity="0.08"
                    BlurRadius="10"
                    ShadowDepth="2" />
  <DropShadowEffect x:Key="ThumbShadowEffect"
                    Color="#FF000000"
                    Opacity="0.2"
                    BlurRadius="6"
                    ShadowDepth="1" />

  <!-- ========================================================================
       第 2 节 · 全局默认样式
       ======================================================================== -->

  <!-- 全局文字默认：13 号 + 理想排版模式 + ClearType -->
  <Style TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <!-- ========================================================================
       第 3 节 · 文字样式
       ======================================================================== -->

  <!-- 区域标题，如「📁 索引配置」 -->
  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSectionHeader}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextHeadingBrush}" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- 表单标签，如「文件夹路径」 -->
  <Style x:Key="LabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinWidth" Value="75" />
  </Style>

  <!-- 次要说明文字，如「分辨率：1920x1080」 -->
  <Style x:Key="InfoTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 强调数值，如索引总数 -->
  <Style x:Key="AccentTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 小号说明文字（12 号） -->
  <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ========================================================================
       第 4 节 · 按钮
       ======================================================================== -->

  <!-- 主要按钮：实心蓝底，用于「搜索」「开始队列」等主操作 -->
  <Style x:Key="PrimaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource RadiusButton}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource BorderInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 次要按钮：白底描边，用于「选择文件夹」「删除」等辅助操作 -->
  <Style x:Key="SecondaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusButton}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource SurfaceDisabledBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 危险按钮：红底，用于确认删除等不可逆操作 -->
  <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#FFB71C1C" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#FF8E0000" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ========================================================================
       第 5 节 · 输入控件
       ======================================================================== -->

  <!-- 文本框 -->
  <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusInput}">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource SurfaceDisabledBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 下拉框 -->
  <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="8,0,8,0" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource SurfaceDisabledBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 复选框（隐式样式，无需 Key 即全局生效） -->
  <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="CheckBoxBorder"
                    Width="18"
                    Height="18"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource BorderInputBrush}"
                    BorderThickness="1.5"
                    CornerRadius="3"
                    Margin="0,0,8,0">
              <Path x:Name="CheckMark"
                    Data="M 2 5 L 6 9 L 12 2"
                    Stroke="{StaticResource PrimaryBrush}"
                    StrokeThickness="2"
                    Visibility="Collapsed"
                    Margin="2" />
            </Border>
            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource PrimaryTintBrush}" />
              <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource SurfaceDisabledBrush}" />
              <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 让复选框默认全局生效（与源项目一致）。
       若你的项目已有自己的 CheckBox 样式，删除下面这一行即可。 -->
  <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBoxStyle}" />

  <!-- 滑块 -->
  <Style x:Key="ModernSliderStyle" TargetType="Slider">
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Background" Value="{StaticResource TrackBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <!-- 轨道底色 -->
            <Border Height="6" Background="{StaticResource TrackBrush}" CornerRadius="3" />

            <Track x:Name="PART_Track">
              <!-- 已填充部分 -->
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge">
                  <RepeatButton.Style>
                    <Style TargetType="RepeatButton">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="RepeatButton">
                            <Border Height="6"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="3,0,0,3" />
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </RepeatButton.Style>
                </RepeatButton>
              </Track.DecreaseRepeatButton>

              <!-- 未填充部分 -->
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge">
                  <RepeatButton.Style>
                    <Style TargetType="RepeatButton">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="RepeatButton">
                            <Border Height="6" Background="Transparent" />
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </RepeatButton.Style>
                </RepeatButton>
              </Track.IncreaseRepeatButton>

              <!-- 滑块手柄 -->
              <Track.Thumb>
                <Thumb Width="20" Height="20">
                  <Thumb.Style>
                    <Style TargetType="Thumb">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Thumb">
                            <Border Background="{StaticResource PrimaryBrush}"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Cursor="Hand"
                                    Effect="{StaticResource ThumbShadowEffect}" />
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </Thumb.Style>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========================================================================
       第 6 节 · 容器
       ======================================================================== -->

  <!-- 卡片：整个界面的基础容器，白底 + 细边 + 轻投影 -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
  </Style>

  <!-- 内嵌面板：卡片内部的次级容器，浅灰底无投影 -->
  <Style x:Key="PanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfacePanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <!-- 卡片内的标题条（灰底 + 下边框） -->
  <Style x:Key="CardHeaderBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfacePanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- 卡片内的底部状态条（灰底 + 上边框） -->
  <Style x:Key="CardFooterBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfacePanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- ========================================================================
       第 7 节 · 数据表格
       ======================================================================== -->

  <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowBackground" Value="{StaticResource SurfaceCardBrush}" />
    <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAltRowBrush}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="CanUserResizeRows" Value="True" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="MinRowHeight" Value="40" />
  </Style>

  <!-- 行样式（通用）：仅处理悬停与选中，可直接用于任意数据源。
       悬停 #E6F3FF，选中 #CCE8FF -->
  <Style x:Key="ModernDataGridRowStyle" TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsEnabled" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
      </MultiTrigger>

      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="True" />
          <Condition Property="IsEnabled" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!-- 行样式（带「数据不可用」置灰）：
       用于「记录对应的文件已不存在」这类场景——把该行置灰且不可选中。

       默认绑定源对象的 IsUnavailable 布尔属性。如果你的数据模型用了别的属性名，
       把下面的 Binding 路径改成自己的即可；不需要这个效果就用上面的
       ModernDataGridRowStyle。 -->
  <Style x:Key="ModernDataGridRowStyleWithUnavailableState"
         TargetType="DataGridRow"
         BasedOn="{StaticResource ModernDataGridRowStyle}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 数据表格内的状态标签（用于「等待/进行中/已完成/失败」等列） -->
  <Style x:Key="StatusTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ========================================================================
       第 8 节 · 列表
       ======================================================================== -->

  <!-- 简洁列表项：撑满宽度，支持选中与悬停 -->
  <Style x:Key="ModernListBoxItemStyle" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ModernListBoxItemStyle}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- ========================================================================
       第 9 节 · 进度反馈
       ======================================================================== -->

  <!-- 细进度条：用于索引进度等 -->
  <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Background" Value="{StaticResource TrackBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
  </Style>

  <!-- 速度/吞吐量面积图容器 -->
  <Style x:Key="ChartContainerStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceWindowBrush}" />
    <Setter Property="BorderBrush" Value="#FFD0D0D0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

</ResourceDictionary>
